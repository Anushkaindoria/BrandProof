DATABASE_URL=sqlite:///./brandproof.db
DEMO_MODE=true
# Set LLM_PROVIDER=gemini and LLM_API_KEY=<your key> to turn on the Gemini auditor,
# smart rewrites and knowledge extraction. Leave as-is for rules-only mode.
LLM_PROVIDER=rules-only
LLM_API_KEY=
# Model names get retired; the -latest alias avoids that. Verify with Settings > Test AI connection.
LLM_MODEL=gemini-flash-latest
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.8
# Signs content passports. Use a long random string outside the demo.
PASSPORT_SECRET=dev-only-change-me
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=uploads
STORAGE_BACKEND=local
S3_STORAGE_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
